+/// Milliseconds from a monotonic high-resolution clock, as performance.now()
+/// in React Native. Added for benchmarking; the CLI has no other timer finer
+/// than Date.now().
+static vm::CallResult<vm::HermesValue> performanceNow(
+    void *,
+    vm::Runtime &) {
+  using namespace std::chrono;
+  double ms =
+      duration<double, std::milli>(steady_clock::now().time_since_epoch())
+          .count();
+  return vm::HermesValue::encodeUntrustedNumberValue(ms);
+}
